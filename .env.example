# Copy this file to .env (which is gitignored) and fill in your own values.
# NEVER commit real secrets. This app never asks for your Robinhood
# password, MFA code, or session cookie - only these API credentials that
# you generate yourself in Robinhood's own settings.

# Official Robinhood Crypto Trading API credentials (crypto live trading only).
# Generate at: Robinhood app -> crypto account settings -> API.
ROBINHOOD_CRYPTO_API_KEY=
ROBINHOOD_CRYPTO_PRIVATE_KEY_B64=

# Free-tier market data provider (https://finnhub.io) used for analysis and
# paper trading. Not required for paper trading with synthetic data, but
# required for real analysis of real prices.
FINNHUB_API_KEY=

# Optional overrides of the conservative defaults (all in trading/config.py):
DEFAULT_RISK_LEVEL=3
MAX_POSITION_PERCENT=0.15
MAX_PORTFOLIO_EXPOSURE=0.65
MAX_DAILY_LOSS_PERCENT=0.03
MAX_OPEN_POSITIONS=8
MAX_SYMBOL_CONCENTRATION_PCT=0.15
MAX_SECTOR_CONCENTRATION_PCT=0.30
QUOTE_STALENESS_SECONDS=60
MIN_AVG_DOLLAR_VOLUME=250000
TRADING_STATE_DIR=logs
